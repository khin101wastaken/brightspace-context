{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:development-roadmap:schema:1",
  "title": "Development roadmap",
  "description": "Reusable milestone graph. Hard edges express prerequisites; optional edges express possible follow-up work. IDs must be unique and references must exist.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "scope", "phases", "milestones", "edges"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "phases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}}
      }
    },
    "milestones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "phase", "title", "status", "deliverable", "acceptance"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "phase": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["done", "in_progress", "next", "planned", "research", "deferred"]},
          "deliverable": {"type": "string", "minLength": 1},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["requires", "optional"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
}
