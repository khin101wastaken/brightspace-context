{
  "manifest_version": 3,
  "name": "Brightspace Catalog (NYU Prototype)",
  "version": "0.9.1",
  "minimum_chrome_version": "116",
  "description": "Catalog NYU Brightspace course outlines locally and request individual document downloads.",
  "permissions": [
    "scripting",
    "storage",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://brightspace.nyu.edu/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brightspace Context",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
